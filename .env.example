# Domain
DOMAIN=localhost

# PostgreSQL
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=changeme

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# OpenBao
OPENBAO_ADDR=http://openbao:8200
OPENBAO_ROOT_TOKEN=changeme

# Object store (Garage)
GARAGE_RPC_SECRET=changeme

# OIDC (set automatically by Keycloak after bootstrap)
OIDC_ISSUER=http://keycloak:8080/realms/aether
OIDC_JWKS_URL=http://keycloak:8080/realms/aether/protocol/openid-connect/certs
OIDC_CLIENT_ID=aether-api

# LLM (Phase 3)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM API key is read from /run/secrets/llm_api_key in production

# Ollama (only needed with compose.local-llm.yaml)
# OLLAMA_MODEL=llama3.2
# OLLAMA_NUM_GPU=0

# Object store
OBJSTORE_ENDPOINT=http://objstore:3900
OBJSTORE_REGION=garage

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# API CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost

# Grafana (only needed with compose.observability.yaml)
# GRAFANA_ADMIN_PASSWORD=changeme
