# ---- AETHER MIGRATE installation settings (copy to .env) -------------------------
# Public URL users open in the browser (scheme + host [+ port]). Used for OIDC redirects.
AETHER_PUBLIC_URL=https://localhost
# Host name Caddy serves; must match AETHER_PUBLIC_URL's host.
AETHER_DOMAIN=localhost
# "internal" = Caddy's local CA (dev/private networks); an e-mail address = ACME (Let's Encrypt).
AETHER_TLS=internal
EDGE_HTTPS_PORT=443
EDGE_HTTP_PORT=80

# First platform administrator (created by bootstrap.sh with a temporary password).
AETHER_ADMIN_EMAIL=admin@example.com
# Require TOTP for the first admin at first login.
AETHER_REQUIRE_ADMIN_MFA=true

AETHER_ENV=prod
AETHER_VERSION=0.1.0
AETHER_LOG_LEVEL=INFO

# The platform's own AWS principal that customer roles trust (shown in setup instructions).
AETHER_AWS_PLATFORM_PRINCIPAL_ARN=
# Optional OTLP gRPC endpoint for traces, e.g. http://otel-collector:4317
AETHER_OTEL_ENDPOINT=

# Local development: plain HTTP on localhost + Temporal UI on 127.0.0.1:8233.
# AETHER_PUBLIC_URL=http://localhost:8580
# AETHER_COMPOSE_OVERLAY=deploy/compose/compose.dev.yaml
# Demo with a simulated AWS estate (no cloud account needed):
# AETHER_COMPOSE_OVERLAY="deploy/compose/compose.dev.yaml deploy/compose/compose.demo.yaml"
