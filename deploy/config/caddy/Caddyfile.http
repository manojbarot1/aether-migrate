{
	http_port 8080
	https_port 8443
	auto_https off
	# Admin API only on loopback (used for the healthcheck/metrics), never exposed.
	admin 127.0.0.1:2019
	servers {
		metrics
	}
}

# Local development only: plain HTTP on localhost (a browser "secure context").
import /etc/caddy/routes.caddy

http://{$AETHER_DOMAIN:localhost} {
	import aether_routes
}
