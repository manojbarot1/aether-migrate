{
  "realm": "aether",
  "enabled": true,
  "displayName": "AETHER MIGRATE",
  "loginTheme": "keycloak",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      { "name": "viewer",           "description": "Read-only access to inventory and snapshots" },
      { "name": "analyst",          "description": "Read access + run assessments and sizing" },
      { "name": "connection-admin", "description": "Create and delete cloud connections" },
      { "name": "approver",         "description": "Approve migration plans (MFA required)" },
      { "name": "operator",         "description": "Execute approved migration steps" },
      { "name": "admin",            "description": "Full workspace administration (MFA required)" }
    ]
  },
  "clients": [
    {
      "clientId": "aether-web",
      "name": "AETHER MIGRATE Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost/*",
        "https://*"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "defaultClientScopes": ["openid", "email", "profile", "roles"]
    },
    {
      "clientId": "aether-api",
      "name": "AETHER MIGRATE API",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "REPLACE_IN_BOOTSTRAP",
      "defaultClientScopes": ["openid", "email", "profile", "roles"]
    }
  ],
  "authenticationFlows": [],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "xRobotsTag": "none"
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "approver",
        "description": "Approve migration plans",
        "attributes": {
          "required_actions": ["CONFIGURE_TOTP"]
        }
      },
      {
        "name": "admin",
        "description": "Full workspace administration",
        "attributes": {
          "required_actions": ["CONFIGURE_TOTP"]
        }
      }
    ]
  },
  "browserFlow": "browser"
}
